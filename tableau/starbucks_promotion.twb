            <column caption='Offer Id' datatype='string' name='[offer_id]' role='dimension' type='nominal' />
            <column caption='Offer Type' datatype='string' name='[offer_type]' role='dimension' type='nominal' />
            <column-instance column='[C_선택 유형별 conversion_rate(복사본)_1397782282760196]' derivation='User' name='[usr:C_선택 유형별 conversion_rate(복사본)_1397782282760196:qk]' pivot='key' type='quantitative' />
            <column-instance column='[C_전체 프로모션 반응률(복사본)_1397782283366405]' derivation='User' name='[usr:C_전체 프로모션 반응률(복사본)_1397782283366405:qk]' pivot='key' type='quantitative' />
