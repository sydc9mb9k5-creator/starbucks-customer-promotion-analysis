          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P_프로모션유형' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;all&quot;'>
              <calculation class='tableau' formula='&quot;all&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0b9b8uj0ibf767143nyjj1xy1m4o'>
            <column caption='C_선택 유형별 실패율' datatype='real' name='[C_선택 유형별 conversion_rate(복사본)_1397782282760196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1-(COUNT(&#13;&#10;    IF [offer_type] =  [Parameters].[매개 변수 1] THEN&#13;&#10;        IF ([offer_type] = &apos;informational&apos; AND [event] = &apos;offer viewed&apos;)&#13;&#10;        OR ([offer_type] != &apos;informational&apos; AND [event] = &apos;offer completed&apos;)&#13;&#10;        THEN [offer_id]&#13;&#10;        END&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT(&#13;&#10;    IF [offer_type] =  [Parameters].[매개 변수 1] AND [event] = &apos;offer received&apos; &#13;&#10;    THEN [offer_id] &#13;&#10;    END&#13;&#10;))' />
            </column>
            <column caption='C_전체 프로모션 실패률' datatype='real' name='[C_전체 프로모션 반응률(복사본)_1397782283366405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - ((&#13;&#10;    COUNT(IF [offer_type] = &apos;informational&apos; AND [event] = &apos;offer viewed&apos; THEN [offer_id] END)&#13;&#10;    +&#13;&#10;    COUNT(IF [offer_type] != &apos;informational&apos; AND [event] = &apos;offer completed&apos; THEN [offer_id] END)&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT(IF [event] = &apos;offer received&apos; THEN [offer_id] END))' />
            </column>
            <column caption='C_선택 유형별 conversion_rate' datatype='real' name='[Calculation_1572879019245578]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [offer_type] =  [Parameters].[매개 변수 1] THEN&#13;&#10;        IF ([offer_type] = &apos;informational&apos; AND [event] = &apos;offer viewed&apos;)&#13;&#10;        OR ([offer_type] != &apos;informational&apos; AND [event] = &apos;offer completed&apos;)&#13;&#10;        THEN [offer_id]&#13;&#10;        END&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT(&#13;&#10;    IF [offer_type] = [Parameters].[매개 변수 1] AND [event] = &apos;offer received&apos; &#13;&#10;    THEN [offer_id] &#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='C_전체 프로모션 반응률' datatype='real' name='[Calculation_1742203530006530 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    COUNT(IF [offer_type] = &apos;informational&apos; AND [event] = &apos;offer viewed&apos; THEN [offer_id] END)&#13;&#10;    +&#13;&#10;    COUNT(IF [offer_type] != &apos;informational&apos; AND [event] = &apos;offer completed&apos; THEN [offer_id] END)&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT(IF [event] = &apos;offer received&apos; THEN [offer_id] END)' />
            </column>
