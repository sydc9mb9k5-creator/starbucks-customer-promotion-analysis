    <worksheet name='전체 - 오퍼유형별 퍼널'>
      <table>
        <view>
          <datasources>
            <datasource caption='starbucks_merged_real_final' name='federated.0b9b8uj0ibf767143nyjj1xy1m4o' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P_프로모션유형' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;all&quot;'>
              <calculation class='tableau' formula='&quot;all&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0b9b8uj0ibf767143nyjj1xy1m4o'>
            <column caption='C_오퍼 수신(n)' datatype='integer' name='[C_오퍼 수신(복사본)_1572879032737808]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// [F1_오퍼 수신]&#13;&#10;-([Calculation_1572879028404236])' />
            </column>
            <column caption='C_오퍼 완료(n)' datatype='integer' name='[C_오퍼 완료(복사본)_1572879032913937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// [F3_오퍼 완료]&#13;&#10;-([Calculation_1572879028547598])' />
            </column>
            <column caption='C_오퍼 조회(n)' datatype='integer' name='[C_오퍼 조회(복사본)_1572879033008146]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// [F2_오퍼 조회]&#13;&#10;-([Calculation_1572879028457485])' />
            </column>
            <column caption='L_viewed_rate' datatype='real' name='[Calculation_1197396592033802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF attr([Calculation_1572879034650643]) = &apos;2. viewed&apos; THEN max([Calculation_1572879056801814]) END' />
            </column>
            <column caption='C_오퍼 수신' datatype='integer' name='[Calculation_1572879028404236]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// [F1_오퍼 수신]&#13;&#10;count(if (([Parameters].[매개 변수 1] = &apos;all&apos;) OR ([offer_type] = [Parameters].[매개 변수 1])) and [event] = &apos;offer received&apos; then [offer_id] end)' />
            </column>
            <column caption='C_오퍼 조회' datatype='integer' name='[Calculation_1572879028457485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// [F1_오퍼 수신]&#13;&#10;count(if (([Parameters].[매개 변수 1] = &apos;all&apos;) OR ([offer_type] = [Parameters].[매개 변수 1])) and [event] = &apos;offer viewed&apos; then [offer_id] end)' />
            </column>
            <column caption='C_오퍼 완료' datatype='integer' name='[Calculation_1572879028547598]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// [F1_오퍼 수신]&#13;&#10;count(if (([Parameters].[매개 변수 1] = &apos;all&apos;) OR ([offer_type] = [Parameters].[매개 변수 1])) and [event] = &apos;offer completed&apos; then [offer_id] end)' />
            </column>
            <column caption='C_퍼널만들기' datatype='string' name='[Calculation_1572879034650643]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([Parameters].[매개 변수 1]= &apos;all&apos;) or [offer_type]=  [Parameters].[매개 변수 1] then&#13;&#10;    if [event] = &apos;offer received&apos; then &apos;1. received&apos;&#13;&#10;    elseif [event] = &apos;offer viewed&apos; then &apos;2. viewed&apos;&#13;&#10;    elseif [event] = &apos;offer completed&apos; then &apos;3. completed&apos;&#13;&#10;    end&#13;&#10;end' />
            </column>
            <column caption='C_view_rate' datatype='real' name='[Calculation_1572879056801814]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ SUM(IF ([Parameters].[매개 변수 1] = &apos;all&apos; OR [offer_type] = [Parameters].[매개 변수 1]) AND [event] = &apos;offer viewed&apos; THEN 1 ELSE 0 END) }&#13;&#10;/&#13;&#10;{ SUM(IF ([Parameters].[매개 변수 1] = &apos;all&apos; OR [offer_type] = [Parameters].[매개 변수 1]) AND [event] = &apos;offer received&apos; THEN 1 ELSE 0 END) }' />
            </column>
            <column caption='C_complete_rate' datatype='real' name='[Calculation_1572879057121303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ SUM(IF ([Parameters].[매개 변수 1] = &apos;all&apos; OR [offer_type] = [Parameters].[매개 변수 1]) AND [event] = &apos;offer completed&apos; THEN 1 ELSE 0 END) }&#13;&#10;/&#13;&#10;{ SUM(IF ([Parameters].[매개 변수 1] = &apos;all&apos; OR [offer_type] = [Parameters].[매개 변수 1]) AND [event] = &apos;offer viewed&apos; THEN 1 ELSE 0 END) }' />
            </column>
            <column caption='L_completed_rate' datatype='real' name='[L_viewed_rate(복사본)_1197396592746507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF attr([Calculation_1572879034650643]) = &apos;3. completed&apos; THEN  max([Calculation_1572879057121303]) END' />
            </column>
            <column caption='Event' datatype='string' name='[event]' role='dimension' type='nominal' />
