      <aliases enabled='yes' />
      <column caption='C_info_리워드경고문구(복사본)' datatype='string' name='[C_info_리워드경고문구(복사본)_1197396638904344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;informational&apos; THEN &#13;&#10;    &apos;informational은 reward 금액이 0달러라&apos; + CHAR(10) + &apos;리워드 금액별 완료율을 계산할 수 없습니다.&apos; &#13;&#10;END' />
      </column>
      <column caption='C_선택 유형별(리워드금액별) conversion_rate' datatype='real' name='[C_선택 유형별 conversion_rate(복사본)_1197396628619286]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF ([Parameters].[매개 변수 1] = &apos;all&apos; OR [offer_type] = [Parameters].[매개 변수 1]) &#13;&#10;    AND [offer_type] != &apos;informational&apos; &#13;&#10;    AND [event] = &apos;offer completed&apos; &#13;&#10;    THEN [offer_id] &#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT(&#13;&#10;    IF ([Parameters].[매개 변수 1] = &apos;all&apos; OR [offer_type] = [Parameters].[매개 변수 1]) &#13;&#10;    AND [offer_type] != &apos;informational&apos; &#13;&#10;    AND [event] = &apos;offer received&apos; &#13;&#10;    THEN [offer_id] &#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='C_선택 유형별 실패율' datatype='real' name='[C_선택 유형별 conversion_rate(복사본)_1397782282760196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(COUNT(&#13;&#10;    IF [offer_type] =  [Parameters].[매개 변수 1] THEN&#13;&#10;        IF ([offer_type] = &apos;informational&apos; AND [event] = &apos;offer viewed&apos;)&#13;&#10;        OR ([offer_type] != &apos;informational&apos; AND [event] = &apos;offer completed&apos;)&#13;&#10;        THEN [offer_id]&#13;&#10;        END&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT(&#13;&#10;    IF [offer_type] =  [Parameters].[매개 변수 1] AND [event] = &apos;offer received&apos; &#13;&#10;    THEN [offer_id] &#13;&#10;    END&#13;&#10;))' />
      </column>
      <column caption='C_오퍼 수신(n)' datatype='integer' name='[C_오퍼 수신(복사본)_1572879032737808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// [F1_오퍼 수신]&#13;&#10;-([Calculation_1572879028404236])' />
      </column>
      <column caption='C_오퍼 완료(n)' datatype='integer' name='[C_오퍼 완료(복사본)_1572879032913937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// [F3_오퍼 완료]&#13;&#10;-([Calculation_1572879028547598])' />
      </column>
      <column caption='C_오퍼 조회(n)' datatype='integer' name='[C_오퍼 조회(복사본)_1572879033008146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// [F2_오퍼 조회]&#13;&#10;-([Calculation_1572879028457485])' />
      </column>
      <column caption='C_전체 프로모션 실패률' datatype='real' name='[C_전체 프로모션 반응률(복사본)_1397782283366405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - ((&#13;&#10;    COUNT(IF [offer_type] = &apos;informational&apos; AND [event] = &apos;offer viewed&apos; THEN [offer_id] END)&#13;&#10;    +&#13;&#10;    COUNT(IF [offer_type] != &apos;informational&apos; AND [event] = &apos;offer completed&apos; THEN [offer_id] END)&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT(IF [event] = &apos;offer received&apos; THEN [offer_id] END))' />
      </column>
      <column caption='C_프로모션유형별매출합계' datatype='real' name='[Calculation_1197396568133632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [offer_type] = [Parameters].[매개 변수 1] then [amount] end)' />
      </column>
      <column caption='C_총프로모션기여매출' datatype='real' name='[Calculation_1197396569010177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [purchase_type] &lt;&gt; &apos;organic&apos; then [amount] end)' />
      </column>
      <column caption='C_all_리워드금액합계' datatype='real' name='[Calculation_1197396570267650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if [offer_type] = &apos;bogo&apos; or  [offer_type] = &apos;discount&apos; then [reward] end)' />
      </column>
      <column caption='C_프로모션유형별리워드합계' datatype='real' name='[Calculation_1197396571865091]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;all&apos; THEN NULL&#13;&#10;ELSEIF [Parameters].[매개 변수 1] = &apos;informational&apos; THEN 0&#13;&#10;ELSE SUM(IF [offer_type] = [Parameters].[매개 변수 1] THEN [reward] END)&#13;&#10;END' />
      </column>
      <column caption='C_총ROI' datatype='real' name='[Calculation_1197396573712389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1197396569010177] / [Calculation_1197396570267650])' />
      </column>
      <column caption='C_프로모션유형별ROI' datatype='real' name='[Calculation_1197396574306310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1197396568133632] / [Calculation_1197396571865091])' />
      </column>
      <column caption='C_info_리워드경고문구' datatype='string' name='[Calculation_1197396574646279]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;informational&apos; THEN &#13;&#10;    &apos;informational은 reward 금액이 0달러라&apos; + CHAR(10) + &apos;ROI를 계산할 수 없습니다.&apos; &#13;&#10;END' />
      </column>
      <column caption='C_프로모션전체발송건수' datatype='integer' name='[Calculation_1197396576186376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [event] = &apos;offer received&apos; THEN [offer_id] END)' />
      </column>
      <column caption='C_프로모션유형별건수세기' datatype='integer' name='[Calculation_1197396579364873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[매개 변수 1] = &apos;all&apos; THEN NULL&#13;&#10;ELSE &#13;&#10;    COUNT(IF [offer_type] = [Parameters].[매개 변수 1] AND [event] = &apos;offer received&apos; &#13;&#10;          THEN [offer_id] &#13;&#10;          END)&#13;&#10;END' />
      </column>
      <column caption='L_viewed_rate' datatype='real' name='[Calculation_1197396592033802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF attr([Calculation_1572879034650643]) = &apos;2. viewed&apos; THEN max([Calculation_1572879056801814]) END' />
      </column>
      <column caption='C_offeridcount' datatype='integer' name='[Calculation_1197396602675213]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count([offer_id])' />
      </column>
      <column caption='C_step1' datatype='string' name='[Calculation_1197396604854286]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Step 1: 오퍼가 실제로 유저에게 도달했는지 확인&#13;&#10;IF { FIXED [offer_id], [person_id] : MAX(IF [event] = &apos;offer received&apos; THEN 1 ELSE 0 END) } = 1 &#13;&#10;THEN &quot;1. 수신 성공&quot; &#13;&#10;ELSE &quot;1. 미수신(발송 실패/제외)&quot; &#13;&#10;END' />
      </column>
      <column caption='C_step2' datatype='string' name='[Calculation_1197396604903439]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// 수신된 것 중 조회했는지, 안 했는지를 구분합니다.&#13;&#10;IF { FIXED [offer_id], [person_id] : MAX(IF [event] = &apos;offer viewed&apos; THEN 1 ELSE 0 END) } = 1 &#13;&#10;THEN &quot;viewed&quot; &#13;&#10;ELSE &quot;out&quot; &#13;&#10;END' />
      </column>
      <column caption='C_step3' datatype='string' name='[Calculation_1197396605014032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [offer_type] = &apos;informational&apos; THEN&#13;&#10;    // 정보성 오퍼: 조회(viewed)만 해도 성공으로 간주&#13;&#10;    IF { FIXED [offer_id], [person_id] : MAX(IF [event] = &apos;offer viewed&apos; THEN 1 ELSE 0 END) } = 1 &#13;&#10;    THEN &quot;success&quot; &#13;&#10;    ELSE &quot;out&quot; &#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    // 그 외 오퍼: 완료(completed)가 있어야 성공&#13;&#10;    IF { FIXED [offer_id], [person_id] : MAX(IF [event] = &apos;offer completed&apos; THEN 1 ELSE 0 END) } = 1 &#13;&#10;    THEN &quot;success&quot; &#13;&#10;    ELSE &quot;out&quot; &#13;&#10;    END&#13;&#10;END' />
      </column>
      <column caption='C_생키하이라이트' datatype='string' name='[Calculation_1197396609257489]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// 매개변수가 &apos;all&apos;이면 모든 유효기간을 각각의 색으로 표시&#13;&#10;// 특정 유형(bogo 등)을 선택하면 그 유형만 유효기간 색을 유지하고 나머지는 회색 처리&#13;&#10;IF [Parameters].[매개 변수 1] = &apos;all&apos; THEN STR([duration])&#13;&#10;ELSEIF [offer_type] = [Parameters].[매개 변수 1] THEN STR([duration])&#13;&#10;ELSE &quot;기타 (비활성화)&quot;&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='C_리워드전체적용' datatype='real' name='[Calculation_1197396617494546]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// 오퍼 ID별로 가장 큰 리워드 값을 찾아서 모든 행에 뿌려줍니다.&#13;&#10;{ FIXED [offer_id] : MAX([reward]) }' />
      </column>
      <column caption='C_덤벨차트용completed' datatype='integer' name='[Calculation_1197396619075604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [event] = &apos;offer viewed&apos; THEN [offer_id] END)' />
      </column>
      <column caption='C_선택 유형별 conversion_rate' datatype='real' name='[Calculation_1572879019245578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [offer_type] =  [Parameters].[매개 변수 1] THEN&#13;&#10;        IF ([offer_type] = &apos;informational&apos; AND [event] = &apos;offer viewed&apos;)&#13;&#10;        OR ([offer_type] != &apos;informational&apos; AND [event] = &apos;offer completed&apos;)&#13;&#10;        THEN [offer_id]&#13;&#10;        END&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT(&#13;&#10;    IF [offer_type] = [Parameters].[매개 변수 1] AND [event] = &apos;offer received&apos; &#13;&#10;    THEN [offer_id] &#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='C_오퍼 수신' datatype='integer' name='[Calculation_1572879028404236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// [F1_오퍼 수신]&#13;&#10;count(if (([Parameters].[매개 변수 1] = &apos;all&apos;) OR ([offer_type] = [Parameters].[매개 변수 1])) and [event] = &apos;offer received&apos; then [offer_id] end)' />
      </column>
      <column caption='C_오퍼 조회' datatype='integer' name='[Calculation_1572879028457485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// [F1_오퍼 수신]&#13;&#10;count(if (([Parameters].[매개 변수 1] = &apos;all&apos;) OR ([offer_type] = [Parameters].[매개 변수 1])) and [event] = &apos;offer viewed&apos; then [offer_id] end)' />
      </column>
      <column caption='C_오퍼 완료' datatype='integer' name='[Calculation_1572879028547598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// [F1_오퍼 수신]&#13;&#10;count(if (([Parameters].[매개 변수 1] = &apos;all&apos;) OR ([offer_type] = [Parameters].[매개 변수 1])) and [event] = &apos;offer completed&apos; then [offer_id] end)' />
      </column>
      <column caption='C_퍼널만들기' datatype='string' name='[Calculation_1572879034650643]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ([Parameters].[매개 변수 1]= &apos;all&apos;) or [offer_type]=  [Parameters].[매개 변수 1] then&#13;&#10;    if [event] = &apos;offer received&apos; then &apos;1. received&apos;&#13;&#10;    elseif [event] = &apos;offer viewed&apos; then &apos;2. viewed&apos;&#13;&#10;    elseif [event] = &apos;offer completed&apos; then &apos;3. completed&apos;&#13;&#10;    end&#13;&#10;end' />
      </column>
      <column caption='C_view_rate' datatype='real' name='[Calculation_1572879056801814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ SUM(IF ([Parameters].[매개 변수 1] = &apos;all&apos; OR [offer_type] = [Parameters].[매개 변수 1]) AND [event] = &apos;offer viewed&apos; THEN 1 ELSE 0 END) }&#13;&#10;/&#13;&#10;{ SUM(IF ([Parameters].[매개 변수 1] = &apos;all&apos; OR [offer_type] = [Parameters].[매개 변수 1]) AND [event] = &apos;offer received&apos; THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='C_complete_rate' datatype='real' name='[Calculation_1572879057121303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ SUM(IF ([Parameters].[매개 변수 1] = &apos;all&apos; OR [offer_type] = [Parameters].[매개 변수 1]) AND [event] = &apos;offer completed&apos; THEN 1 ELSE 0 END) }&#13;&#10;/&#13;&#10;{ SUM(IF ([Parameters].[매개 변수 1] = &apos;all&apos; OR [offer_type] = [Parameters].[매개 변수 1]) AND [event] = &apos;offer viewed&apos; THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='C_전체 프로모션 반응률' datatype='real' name='[Calculation_1742203530006530 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    COUNT(IF [offer_type] = &apos;informational&apos; AND [event] = &apos;offer viewed&apos; THEN [offer_id] END)&#13;&#10;    +&#13;&#10;    COUNT(IF [offer_type] != &apos;informational&apos; AND [event] = &apos;offer completed&apos; THEN [offer_id] END)&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT(IF [event] = &apos;offer received&apos; THEN [offer_id] END)' />
      </column>
      <column caption='C_전체목표달성률' datatype='real' name='[Calculation_1742203530006530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    COUNT(IF [offer_type] = &apos;informational&apos; AND [event] = &apos;offer viewed&apos; THEN [offer_id] END)&#13;&#10;    +&#13;&#10;    COUNT(IF [offer_type] != &apos;informational&apos; AND [event] = &apos;offer completed&apos; THEN [offer_id] END)&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT(IF [event] = &apos;offer received&apos; THEN [offer_id] END)' />
      </column>
      <column caption='F score' datatype='integer' name='[F_score]' role='measure' type='quantitative' />
      <column caption='L_completed_rate' datatype='real' name='[L_viewed_rate(복사본)_1197396592746507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF attr([Calculation_1572879034650643]) = &apos;3. completed&apos; THEN  max([Calculation_1572879057121303]) END' />
