    <worksheet name='오퍼유효기간별 퍼널'>
      <table>
        <view>
          <datasources>
            <datasource caption='starbucks_merged_real_final' name='federated.0b9b8uj0ibf767143nyjj1xy1m4o' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='P_프로모션유형' datatype='string' name='[매개 변수 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;all&quot;'>
              <calculation class='tableau' formula='&quot;all&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0b9b8uj0ibf767143nyjj1xy1m4o'>
            <column caption='C_offeridcount' datatype='integer' name='[Calculation_1197396602675213]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count([offer_id])' />
            </column>
            <column caption='C_step2' datatype='string' name='[Calculation_1197396604903439]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// 수신된 것 중 조회했는지, 안 했는지를 구분합니다.&#13;&#10;IF { FIXED [offer_id], [person_id] : MAX(IF [event] = &apos;offer viewed&apos; THEN 1 ELSE 0 END) } = 1 &#13;&#10;THEN &quot;viewed&quot; &#13;&#10;ELSE &quot;out&quot; &#13;&#10;END' />
            </column>
            <column caption='C_step3' datatype='string' name='[Calculation_1197396605014032]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [offer_type] = &apos;informational&apos; THEN&#13;&#10;    // 정보성 오퍼: 조회(viewed)만 해도 성공으로 간주&#13;&#10;    IF { FIXED [offer_id], [person_id] : MAX(IF [event] = &apos;offer viewed&apos; THEN 1 ELSE 0 END) } = 1 &#13;&#10;    THEN &quot;success&quot; &#13;&#10;    ELSE &quot;out&quot; &#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    // 그 외 오퍼: 완료(completed)가 있어야 성공&#13;&#10;    IF { FIXED [offer_id], [person_id] : MAX(IF [event] = &apos;offer completed&apos; THEN 1 ELSE 0 END) } = 1 &#13;&#10;    THEN &quot;success&quot; &#13;&#10;    ELSE &quot;out&quot; &#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='C_생키하이라이트' datatype='string' name='[Calculation_1197396609257489]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// 매개변수가 &apos;all&apos;이면 모든 유효기간을 각각의 색으로 표시&#13;&#10;// 특정 유형(bogo 등)을 선택하면 그 유형만 유효기간 색을 유지하고 나머지는 회색 처리&#13;&#10;IF [Parameters].[매개 변수 1] = &apos;all&apos; THEN STR([duration])&#13;&#10;ELSEIF [offer_type] = [Parameters].[매개 변수 1] THEN STR([duration])&#13;&#10;ELSE &quot;기타 (비활성화)&quot;&#13;&#10;END' />
            </column>
            <column caption='C_퍼널만들기' datatype='string' name='[Calculation_1572879034650643]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if ([Parameters].[매개 변수 1]= &apos;all&apos;) or [offer_type]=  [Parameters].[매개 변수 1] then&#13;&#10;    if [event] = &apos;offer received&apos; then &apos;1. received&apos;&#13;&#10;    elseif [event] = &apos;offer viewed&apos; then &apos;2. viewed&apos;&#13;&#10;    elseif [event] = &apos;offer completed&apos; then &apos;3. completed&apos;&#13;&#10;    end&#13;&#10;end' />
            </column>
            <column aggregation='Sum' caption='Duration' datatype='real' name='[duration]' role='dimension' type='ordinal' />
            <column caption='Event' datatype='string' name='[event]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1197396604903439]' derivation='None' name='[none:Calculation_1197396604903439:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1197396605014032]' derivation='None' name='[none:Calculation_1197396605014032:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1197396609257489]' derivation='None' name='[none:Calculation_1197396609257489:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1572879034650643]' derivation='None' name='[none:Calculation_1572879034650643:nk]' pivot='key' type='nominal' />
            <column-instance column='[duration]' derivation='None' name='[none:duration:ok]' pivot='key' type='ordinal' />
            <column caption='Offer Id' datatype='string' name='[offer_id]' role='dimension' type='nominal' />
            <column caption='Offer Type' datatype='string' name='[offer_type]' role='dimension' type='nominal' />
            <column caption='Person Id' datatype='string' name='[person_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1197396602675213]' derivation='User' name='[usr:Calculation_1197396602675213:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0b9b8uj0ibf767143nyjj1xy1m4o].[none:Calculation_1572879034650643:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_1572879034650643:nk]' member='&quot;1. received&quot;' />
              <groupfilter function='member' level='[none:Calculation_1572879034650643:nk]' member='&quot;2. viewed&quot;' />
              <groupfilter function='member' level='[none:Calculation_1572879034650643:nk]' member='&quot;3. completed&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0b9b8uj0ibf767143nyjj1xy1m4o].[none:Calculation_1572879034650643:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <_.fcp.VizExtensions.false...mark class='Automatic' />
            <_.fcp.VizExtensions.true...mark class='VizExtension' />
            <_.fcp.VizExtensions.true...add-in add-in-id='com.tableau.extension.sankey' extension-url='https://extensions.tableauusercontent.com/sandbox/sankey/sankey.html' extension-version='1.5.0' instance-id='35A56DD5B2F54BF29DF90FA031362C5C'>
              <instance-settings>
                <setting key='align-edges' value='true' />
                <setting key='color-map' value='{&quot;C_step2&quot;:[[&quot;2. 조회 안 함(이탈)&quot;,&quot;#b07aa1&quot;],[&quot;2. 조회함&quot;,&quot;#ff9da7&quot;],[&quot;2. 이탈&quot;,&quot;#e15759&quot;],[&quot;이탈&quot;,&quot;#b07aa1&quot;],[&quot;viewed&quot;,&quot;#ff9da7&quot;],[&quot;조회&quot;,&quot;#ff9da7&quot;],[&quot;out&quot;,&quot;#b07aa1&quot;]],&quot;C_step3&quot;:[[&quot;3. 완료 안 함(이탈)&quot;,&quot;#9c755f&quot;],[&quot;3. 완료함&quot;,&quot;#bab0ac&quot;],[&quot;3. 이탈&quot;,&quot;#59a14f&quot;],[&quot;3. 성공(목표 달성)&quot;,&quot;#9c755f&quot;],[&quot;이탈&quot;,&quot;#9c755f&quot;],[&quot;목표 달성&quot;,&quot;#bab0ac&quot;],[&quot;out&quot;,&quot;#ff9da7&quot;],[&quot;success&quot;,&quot;#9c755f&quot;]],&quot;C_생키하이라이트&quot;:[[&quot;3&quot;,&quot;#edc948&quot;],[&quot;4&quot;,&quot;#4e79a7&quot;],[&quot;5&quot;,&quot;#f28e2b&quot;],[&quot;7&quot;,&quot;#e15759&quot;],[&quot;10&quot;,&quot;#76b7b2&quot;]]}' />
                <setting key='color-palette' value='tableau10' />
                <setting key='ignore-nulls' value='true' />
                <setting key='level-labels-font' value='{&quot;size&quot;:&quot;11pt&quot;,&quot;color&quot;:&quot;#000000&quot;,&quot;family&quot;:&quot;Verdana&quot;,&quot;isBold&quot;:false,&quot;isItalic&quot;:false,&quot;isUnderlined&quot;:false}' />
                <setting key='show-level-labels' value='true' />
                <setting key='show-top-labels' value='false' />
              </instance-settings>
              <type-settings>
                <worksheet />
              </type-settings>
            </_.fcp.VizExtensions.true...add-in>
